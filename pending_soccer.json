import os
import sys
import json
import re

STATE_FILE = "pending_soccer.json"

def validate_state():
    if not os.path.exists(STATE_FILE):
        print(f"❌ FEHLER: Datei {STATE_FILE} wurde nicht gefunden.")
        sys.exit(1)

    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:
        print(f"❌ FEHLER: Parsing von {STATE_FILE} fehlgeschlagen: {e}")
        sys.exit(1)

    errors = []

    # 1. POTD-Prüfung
    potd = data.get("potd")
    if not potd or not isinstance(potd, dict):
        errors.append("Bereich 'potd' fehlt oder ist kein gültiges Objekt.")
    else:
        if not potd.get("match") or not potd.get("pick"):
            errors.append("POTD unvollständig: 'match' oder 'pick' fehlt.")
        try:
            p_odds = float(str(potd.get("odds", 0)).replace(",", "."))
            if p_odds < 1.05 or p_odds > 15.0:
                errors.append(f"POTD Quote unplausibel: {p_odds}")
        except ValueError:
            errors.append(f"POTD Quote ungültig: {potd.get('odds')}")

    # 2. Tickets- & Pick-Prüfung
    tickets = data.get("tickets", [])
    if not isinstance(tickets, list) or len(tickets) == 0:
        errors.append("Keine Tickets im Feld 'tickets' vorhanden.")

    for idx, ticket in enumerate(tickets, start=1):
        t_name = str(ticket.get("ticket_name", "")).upper()

        # Ausschluss von Player-Prop-Kategorien
        if any(bad in t_name for bad in ["PLAYER", "PROP", "SPIELER", "TORSCHUSS", "SCHUSS"]):
            errors.append(f"Ticket #{idx} ('{ticket.get('ticket_name')}') ist ein gesperrtes Player-Prop-Ticket.")

        picks = ticket.get("picks", [])
        if not isinstance(picks, list) or len(picks) == 0:
            errors.append(f"Ticket #{idx} ('{t_name}') enthält keine Picks.")
            continue

        for p_idx, pick in enumerate(picks, start=1):
            # Einzelspieler-Felder sperren
            if "player" in pick:
                errors.append(
                    f"Ticket #{idx}, Pick #{p_idx}: Feld 'player' vorhanden ({pick.get('player')}). "
                    f"Spielerwetten sind deaktiviert."
                )

            p_text = str(pick.get("pick", "")).lower()
            if any(term in p_text for term in ["schuss", "torschuss", "sot", "spieler", "scorer", "assist"]):
                errors.append(
                    f"Ticket #{idx}, Pick #{p_idx}: Pick-Text '{pick.get('pick')}' enthält gesperrte Spieler-Metriken."
                )

            match_name = pick.get("match", "")
            if not match_name or "vs" not in match_name.lower():
                errors.append(f"Ticket #{idx}, Pick #{p_idx}: Ungültiger Matchname '{match_name}'.")

            # Quoten-Plausibilität
            try:
                odds_val = float(str(pick.get("odds", 0)).replace(",", "."))
                if odds_val < 1.05 or odds_val > 15.0:
                    errors.append(
                        f"Ticket #{idx}, Pick #{p_idx} ({match_name}): Quote {odds_val} außerhalb des Rahmens (1.05 - 15.0)."
                    )
            except ValueError:
                errors.append(f"Ticket #{idx}, Pick #{p_idx} ({match_name}): Quote ungültig: {pick.get('odds')}")

    # 3. Text-Filter für Telegram-Post
    raw_text = str(data.get("original_text", "")).lower()
    if not raw_text:
        errors.append("Feld 'original_text' ist leer.")

    forbidden_keywords = [
        "player prop",
        "torschuss",
        "schüsse aufs tor",
        "shots on target",
        "lewandowski"
    ]
    for keyword in forbidden_keywords:
        if keyword in raw_text:
            errors.append(f"Gesperrter Begriff '{keyword}' im 'original_text' gefunden.")

    # 4. Auswertung
    if errors:
        print("🚨 VALIDIERUNG FEHLGESCHLAGEN! Der Telegram-Post wird blockiert:")
        for err in errors:
            print(f"  • {err}")
        sys.exit(1)

    print("✅ VALIDIERUNG ERFOLGREICH: Alle Prüfungen bestanden. Freigabe erteilt.")
    sys.exit(0)

if __name__ == "__main__":
    validate_state()
